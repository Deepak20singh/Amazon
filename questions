TREE ORDER TRAVERSAL


https://leetcode.com/problems/binary-tree-level-order-traversal/

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<List<Integer>> levelOrder(TreeNode root) {
        
        List<List<Integer>> ans=new ArrayList<>();
         if (root == null) return ans;
        Queue<TreeNode> q=new LinkedList<>();

        q.offer(root);
       
        while(!q.isEmpty()){
            
            int size = q.size(); 
            List<Integer> level = new ArrayList<>();

            for(int i=0;i<size;i++){
                 TreeNode node = q.poll();
               
                level.add(node.val);
                if(node.left!=null)q.offer(node.left);
                if (node.right != null) q.offer(node.right);

            }
            ans.add(level);

            


        }
     
    return ans;
    }
}


ALL NODES DISTANCE K IN BINARY TREE


https://leetcode.com/problems/all-nodes-distance-k-in-binary-tree/description/


class Solution {
    
    public void build(TreeNode n, TreeNode p, Map<TreeNode, TreeNode> mp) {
        if (n == null) return;

        mp.put(n, p);
        build(n.left, n, mp);   // ✔️ fix
        build(n.right, n, mp);  // ✔️ fix
    }

    public List<Integer> distanceK(TreeNode root, TreeNode target, int k) {
        Map<TreeNode, TreeNode> parent = new HashMap<>();
        build(root, null, parent);

        Queue<TreeNode> q = new LinkedList<>();
        Set<TreeNode> visit = new HashSet<>();

        q.offer(target);
        visit.add(target);

        int dist = 0;

        while (!q.isEmpty()) {
            int size = q.size();

            if (dist == k) break;

            for (int i = 0; i < size; i++) {
                TreeNode cur = q.poll(); // ✔️ fix

                if (cur.left != null && !visit.contains(cur.left)) {
                    q.offer(cur.left);
                    visit.add(cur.left);
                }

                if (cur.right != null && !visit.contains(cur.right)) {
                    q.offer(cur.right);
                    visit.add(cur.right);
                }

                if (parent.get(cur) != null && !visit.contains(parent.get(cur))) {
                    q.offer(parent.get(cur));
                    visit.add(parent.get(cur));
                }
            }

            dist++;
        }

        List<Integer> ans = new ArrayList<>();
        while (!q.isEmpty()) {
            ans.add(q.poll().val);
        }

        return ans;
    }
}





Kth Smallest Element in a BST

https://leetcode.com/problems/kth-smallest-element-in-a-bst/description/

/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public void inorder(TreeNode root,List<TreeNode> li){
       if(root==null){
        return;
       }
        inorder(root.left,li);
        li.add(root);
        inorder(root.right,li);
    }
    public int kthSmallest(TreeNode root, int k) {
        List<TreeNode> li=new ArrayList<>();
        inorder(root,li);
        int ans=0;
        TreeNode p=li.get(k-1);
        ans=p.val;
        return ans;
    }
} 

